{
  "name": "boss-workbench-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "boss 直聘求职端自动化桌面端",
  "author": {
    "name": "Aanlik",
    "email": "Aanlik@users.noreply.github.com"
  },
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:build": "python3 scripts/build_desktop.py",
    "desktop:pack": "electron-builder --mac dir",
    "desktop:dist": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.bossworkbench.desktop",
    "productName": "boss 直聘求职端自动化",
    "artifactName": "boss-auto-apply-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-desktop/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-desktop/browser",
        "to": "browser",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "maintainer": "Aanlik <Aanlik@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "release/desktop"
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  }
}
