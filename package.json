{
  "name": "boss-workbench-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "boss 求职助手桌面端",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:build": "python3 scripts/build_desktop.py",
    "desktop:pack": "electron-builder --mac dir",
    "desktop:dist": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.bossworkbench.desktop",
    "productName": "boss 求职助手",
    "artifactName": "boss-auto-apply-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png",
    "asar": true,
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-desktop/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-desktop/browser",
        "to": "browser",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "boss 求职助手",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "release/desktop"
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  }
}
